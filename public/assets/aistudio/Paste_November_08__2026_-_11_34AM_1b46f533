        <div className={tab === "simple" ? undefined : "hidden"}>
          <SimpleScreen analysis={analysis} onSeed={sendToBuild} />
        </div>
        <div className={tab === "lanes" ? undefined : "hidden"}>
          <LanesScreen onSeed={sendToBuild} />
        </div>
        <div className={tab === "takes" ? undefined : "hidden"}>
          <TakesScreen onSeed={sendToBuild} onBuild={() => setTab("build")} />
        </div>
        <div className={tab === "advisor" ? undefined : "hidden"}>
          <AdvisorScreen />
        </div>
      </main>

      <nav
        aria-label="Main screens"
        className="pb-safe fixed inset-x-0 bottom-0 border-t border-[var(--border)] bg-[var(--surface)]"
      >
        <div className="mx-auto grid w-full max-w-2xl grid-cols-7">
          {TABS.map((t) => {
            const active = tab === t.value;
            return (
              <button
