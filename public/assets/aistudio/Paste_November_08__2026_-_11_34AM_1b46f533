  });
  const countFor = (f: ResultFilter) =>
    f === "all"
      ? loaded.length
      : loaded.filter((t) => t.result === f).length;

  return (
    <div>
      <h2 className="font-display text-2xl">Takes</h2>
      <p className="mt-1 text-sm text-[var(--dim)]">
        Saved packages live here — copy them back into Suno any time.
      </p>

      {takes.data && total > 0 && (
        <div className="mt-4">
          <p className="text-sm text-[var(--dim)]" aria-live="polite">
            {total} {total === 1 ? "take" : "takes"} saved
            {total > loaded.length
              ? ` — showing the newest ${loaded.length}`
              : ""}
            {" · "}
            {filtered.length} shown
          </p>
          {(() => {
            // Win rate over DECIDED takes only (winners + misses) —
            // pending takes have no result yet, so counting them
            // would understate the rate. Computed over the loaded
            // page, and labeled as such when the list is capped.
            const winners = countFor("winner");
            const misses = countFor("miss");
            const decided = winners + misses;
            if (decided === 0) return null;
            return (
              <p className="mt-1 text-sm text-[var(--dim)]">
                Win rate {Math.round((winners / decided) * 100)}% —{" "}
                {winners} {winners === 1 ? "winner" : "winners"} of{" "}
                {decided} decided {decided === 1 ? "take" : "takes"}
                {total > loaded.length ? " (loaded takes)" : ""}. The
                packages that won are the pattern to reuse.
              </p>
            );
          })()}
          <div className="mt-3">
            <label htmlFor="takes-search" className="sr-only">
              Search takes by name or lane
            </label>
            <input
              id="takes-search"
              type="search"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search takes by name or lane…"
              className={inputCls}
            />
          </div>
          <div
            className="mt-3 flex flex-wrap gap-2"
            role="group"
            aria-label="Filter takes by result"
          >
            {RESULT_FILTERS.map((f) => {
              const active = resultFilter === f.value;
              return (
                <button
                  key={f.value}
                  type="button"
                  aria-pressed={active}
                  onClick={() => setResultFilter(f.value)}
                  className={`min-h-[44px] rounded-full border px-4 text-sm font-bold ${
                    active
                      ? "border-[var(--accent)] bg-[var(--accent)] text-[var(--accent-ink)]"
                      : "border-[var(--border)] bg-[var(--surface)] text-[var(--text)]"
                  }`}
                >
                  {f.label} · {countFor(f.value)}
                </button>
              );
            })}
          </div>
        </div>
      )}

      {takes.isPending && (
        <p className="mt-8 text-center text-base text-[var(--dim)]">
          Loading your takes…
        </p>
      )}

      {takes.isError && (
        <div className="mt-6 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-8 text-center">
          <p className="text-base font-bold">Takes couldn't load.</p>
          <button
            type="button"
            onClick={() => takes.refetch()}
            className="mt-4 min-h-[48px] rounded-md bg-[var(--accent)] px-5 font-bold text-[var(--accent-ink)]"
          >
            Try again
          </button>
        </div>
      )}

      {takes.data?.owner_required && (
        <div className="mt-6 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-8 text-center">
          <p className="text-base font-bold">Takes are the owner's saved packages.</p>
          <p className="mt-1 text-sm leading-relaxed text-[var(--dim)]">
            You're viewing this app without the owner's sign-in, so the
            saved takes stay private. The Library, Build, Simple, Lanes
            and Advisor screens all work — only the saved packages are
            owner-only. Sign in as the owner to see them.
          </p>
        </div>
      )}

      {takes.data && !takes.data.owner_required && takes.data.takes.length === 0 && (
        <div className="mt-6 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-8 text-center">
          <p className="text-base font-bold">No takes saved yet.</p>
          <p className="mt-1 text-sm leading-relaxed text-[var(--dim)]">
            Build a package, tap Save as Take, and it lands here with room for
            its result — so a winning package never gets lost.
          </p>
          <button
            type="button"
            onClick={onBuild}
            className="mt-4 min-h-[48px] rounded-md bg-[var(--accent)] px-5 font-bold text-[var(--accent-ink)]"
          >
            Go to Build
          </button>
        </div>
      )}

      {takes.data && takes.data.takes.length > 0 && filtered.length === 0 && (
        <div className="mt-6 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-8 text-center">
          <p className="text-base font-bold">No takes match that filter.</p>
          <p className="mt-1 text-sm text-[var(--dim)]">
            Your saved takes are still here — the filter is just hiding them.
          </p>
          <button
            type="button"
            onClick={() => {
              setResultFilter("all");
              setSearch("");
            }}
            className="mt-4 min-h-[48px] rounded-md bg-[var(--accent)] px-5 font-bold text-[var(--accent-ink)]"
          >
            Clear filters
          </button>
        </div>
      )}

      {takes.data && filtered.length > 0 && (
        <ul className="mt-4 space-y-3">
          {filtered.map((take) => (
            <TakeCard key={take.id} take={take} onSeed={onSeed} />
          ))}
        </ul>
      )}
    </div>
  );
}


