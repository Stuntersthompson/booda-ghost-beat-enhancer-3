  analysis: BeatAnalysis | null;
  onSeed: (seed: Omit<BuildSeed, "nonce">) => void;
}) {
  const [job, setJob] = useState<JobType>("original");
  const [lane, setLane] = useState("Trap");
  const [current, setCurrent] = useState<SimplePrompt | undefined>(() =>
    SIMPLE_PROMPTS.find((p) => p.job === "original" && p.lane === "Trap"),
  );
  const [query, setQuery] = useState("");
  const [browseLane, setBrowseLane] = useState("all");
  const [browseJob, setBrowseJob] = useState<"all" | JobType>("all");
  const [visible, setVisible] = useState(PAGE);
  const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set());

  // Remix Templates state — family filter + current pick.
  const [remixFamily, setRemixFamily] = useState("all");
  const [remixJob, setRemixJob] = useState<JobType>("preserve");
  const [remixCurrent, setRemixCurrent] = useState<RemixTemplate | undefined>(
    () =>
      REMIX_TEMPLATES.find(
        (t) => t.job === "preserve" && t.lane === "Trap" && t.family === "Faithful Enhance",
      ) ?? REMIX_TEMPLATES[0],
  );
  const [browseKind, setBrowseKind] = useState<"all" | "paragraph" | "directive" | "remix">("all");

  // Package assembler state — directive + inserted style + structure.
