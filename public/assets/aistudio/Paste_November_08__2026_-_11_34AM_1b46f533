type Tab = "analyze" | "library" | "build" | "simple" | "lanes" | "takes" | "advisor";

const TABS: { value: Tab; label: string }[] = [
  { value: "analyze", label: "Analyze" },
  { value: "library", label: "Library" },
  { value: "build", label: "Build" },
  { value: "simple", label: "Simple" },
  { value: "lanes", label: "Lanes" },
  { value: "takes", label: "Takes" },
  { value: "advisor", label: "Advisor" },
];

export function App() {
  const [tab, setTab] = useState<Tab>("build");
  const [seed, setSeed] = useState<BuildSeed>({ nonce: 0 });
  const [analysis, setAnalysis] = useState<BeatAnalysis | null>(null);

  function sendToBuild(partial: Omit<BuildSeed, "nonce">) {
    setSeed({ ...partial, nonce: Date.now() });
