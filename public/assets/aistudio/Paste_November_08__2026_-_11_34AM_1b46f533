// Genre Ammo Expansion bank — Boo's 2026-10-27 expansion, bundled verbatim
// from genre-ammo-expansion-data-2026-10-27.json (212 prompts: 94 styles ×
// Original+Preserve across 11 sections, plus 12 technical moves × 2).
// Source docs were pasted production references, unverified as facts; the
// prompts are creative steering text. This bank is kept SEPARATE from the
// verified V2 bank (bank.ts) everywhere it surfaces — its own Library
// category and its own Build pick lists, labeled "Ammo".

import rawAmmo from "./ammo.json";
import { LOCK_LINE } from "./bank";

export interface AmmoStyle {
  name: string;
  original: string;
  preserve: string;
}

export interface AmmoSection {
  section: string;
  styles: AmmoStyle[];
}

export interface AmmoMove {
  name: string;
  original: string;
  preserve: string;
}

interface AmmoShape {
  source: string;
  sections: AmmoSection[];
  technical_moves: AmmoMove[];
}

export const ammo = rawAmmo as AmmoShape;

export const AMMO_SOURCE_NOTE = ammo.source;

export function ammoStyleCount(): number {
  return ammo.sections.reduce((n, s) => n + s.styles.length, 0);
}

export function ammoText(style: AmmoStyle, job: "original" | "preserve"): string {
  return job === "preserve" ? style.preserve : style.original;
}

export function ammoMoveText(move: AmmoMove, job: "original" | "preserve"): string {
  return job === "preserve" ? move.preserve : move.original;
}

/**
 * The technical-move layer for Style assembly. Ammo preserve moves carry
 * the full lock-line sentence; for layering we strip that leading sentence
 * (the base prompt already carries the lock on Preserve jobs) and keep the
 * move's drum/texture direction. Original moves are full standalone
 * prompts, so the layer uses their descriptive tail after the genre head.
 */
export function moveLayerText(move: AmmoMove, job: "original" | "preserve"): string {
  const full = ammoMoveText(move, job);
  if (job === "preserve") {
    const prefix = `${LOCK_LINE}. `;
    return full.startsWith(prefix) ? full.slice(prefix.length) : full;
  }
  const comma = full.indexOf(", ");
  return comma >= 0 ? full.slice(comma + 2) : full;
}


