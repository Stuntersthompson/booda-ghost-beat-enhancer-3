  const [asmJob, setAsmJob] = useState<JobType>("preserve");
  const [asmLane, setAsmLane] = useState("Trap");
  const [asmStyleIdx, setAsmStyleIdx] = useState(0);
  const [asmHead, setAsmHead] = useState<"directive" | "remix">("directive");
  const [asmFamily, setAsmFamily] = useState("Faithful Enhance");
  const asmDirective = directiveFor(asmJob, asmLane);
  const asmRemix = remixTemplatesFor(asmJob, asmLane, asmFamily)[0];
  const asmStyles = isExpansionLane(asmLane)
    ? expansionStylePromptsFor(asmJob, asmLane)
    : stylePromptsFor(asmJob, asmLane);
  const asmStyle = asmStyles[Math.min(asmStyleIdx, Math.max(0, asmStyles.length - 1))];
  const assembled =
    asmHead === "remix"
      ? asmRemix && asmStyle
        ? assembleRemixPackage(asmRemix.text, asmStyle.text, asmJob)
        : ""
      : asmDirective && asmStyle
