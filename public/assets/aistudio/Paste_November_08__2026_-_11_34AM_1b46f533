}

export function BuildScreen({
  seed,
  onOpenTakes,
  analysis,
  onClearAnalysis,
}: {
  seed: BuildSeed;
  onOpenTakes: () => void;
  analysis: BeatAnalysis | null;
  onClearAnalysis: () => void;
}) {
  const bootRef = useRef<{ state: BuildState; restored: boolean } | null>(null);
  if (bootRef.current === null) bootRef.current = loadDraft();
  const [s, setS] = useState<BuildState>(bootRef.current.state);
  const [draftRestored, setDraftRestored] = useState(bootRef.current.restored);
  const lastNonce = useRef(seed.nonce);
  const [takeName, setTakeName] = useState("");
  const [savedMsg, setSavedMsg] = useState<string | null>(null);
  const [gospelGroup, setGospelGroup] = useState("all");
  const [ammoSection, setAmmoSection] = useState(0);

  useEffect(() => {
    if (seed.nonce !== lastNonce.current) {
      lastNonce.current = seed.nonce;
      setS((prev) => applySeed(prev, seed));
      setSavedMsg(null);
    }
  }, [seed]);

  // Persist every Build change as the on-device draft.
  useEffect(() => {
    try {
      window.localStorage.setItem(DRAFT_KEY, JSON.stringify(s));
    } catch {
      // Storage unavailable — the draft just lives for this session.
    }
  }, [s]);

  const patch = (p: Partial<BuildState>) =>
    setS((prev) => ({ ...prev, ...p }));

  const changeJob = (job: JobType) =>
    setS((prev) => {
      const next = repick(prev, job, prev.lane);
      const name = prev.moveLabel.replace("Technical move · ", "");
      const mv = ammo.technical_moves.find((m) => m.name === name);
      if (mv) next.moveText = moveLayerText(mv, job);
      return next;
    });
  const changeLane = (lane: string) =>
    setS((prev) => repick(prev, prev.job, lane));

  const lanePicks = isExpansionLane(s.lane)
    ? expansionStylePromptsFor(s.job, s.lane).map((p) => ({
        text: p.text,
        applicability: "Expansion lane",
      }))
    : stylePromptsFor(s.job, s.lane);
  const laneFramework = frameworkFor(s.lane);
  const laneSource = expansionLane(s.lane);
  const gospelPicks =
    s.lane === "Gospel trap"
      ? bank.gospel_prompts.filter(
          (g) => gospelGroup === "all" || g.group === gospelGroup,
        )
      : [];
  const gospelGroups = [...new Set(bank.gospel_prompts.map((g) => g.group))];
  // Simple-box prompts woven into Build: this lane's prompts for the
  // current job, plus every Ammo-style Simple prompt for the job.
  const simpleLanePicks = simplePromptsFor(s.job, s.lane);
  const simpleAmmoPicks = SIMPLE_PROMPTS.filter(
    (p) => p.job === s.job && p.source === "Ammo",
  );
  const simpleDirectivePicks = SIMPLE_DIRECTIVES.filter(
    (d) => d.job === s.job,
  );
  const remixLanePicks = remixTemplatesFor(s.job, s.lane);
  const remixAmmoPicks = REMIX_TEMPLATES.filter(
    (t) => t.job === s.job && t.source.includes("Ammo"),
  );
  const simpleLockMissing =
    s.job === "preserve" && !s.simpleText.includes(LOCK_LINE);
  const settings = settingsLine(s);
  const assembledStyle = assembleStyle(
    s.styleText,
    s.moveText,
    s.slotDetail,
    s.job,
    STYLE_LIMIT,
  );
  // The same assembly with no cap, to detect silent truncation:
  // assembleStyle caps its output at the Style limit (layers dropped
  // first, then the base itself is cut) — when that happens the user
  // must be told, because the text in the box above is no longer
  // exactly what Copy / Save will carry.
  const assembledFull = assembleStyle(
    s.styleText,
    s.moveText,
    s.slotDetail,
    s.job,
    Number.MAX_SAFE_INTEGER,
  );
  const styleTruncated = assembledFull.length > STYLE_LIMIT;
  // Server save caps (createTake): style 4,000 · exclude 4,000 ·
  // lyrics 12,000. A hand-pasted over-long block would otherwise fail
  // the save with only a generic connection message.
  const saveOverLimit =
    assembledStyle.length > 4000 ||
    s.excludeText.length > 4000 ||
    s.lyricsText.length > 12000;
  // One-paste copy of the whole package — all four blocks with headers,
  // for pasting into notes or a chat in a single shot.
  const fullPackage = [
    `STYLE\n${assembledStyle}`,
    `EXCLUDE\n${s.excludeText}`,
    `LYRICS MAP\n${s.lyricsText}`,
    `SETTINGS\n${settings}`,
  ].join("\n\n");
  const lockMissing =
    s.job === "preserve" && !assembledStyle.includes(LOCK_LINE);
  const lyricsEndsOk = s.lyricsText.trimEnd().endsWith("[End]");
  const canSave =
    assembledStyle.trim().length > 0 && s.lyricsText.trim().length > 0;

  // --- Randomize -----------------------------------------------------
  // While an analysis is loaded, lane picks stay inside the measured
  // lane/pocket. Every pick draws from the real banks; settings stay
  // inside Boo's tested bands (see randomize.ts).
  const lockedLane = analysis?.suggestedLane ?? null;

  function randomStylePick(job: JobType, lane: string): Partial<BuildState> {
    const picks: { text: string }[] = isExpansionLane(lane)
      ? expansionStylePromptsFor(job, lane)
      : stylePromptsFor(job, lane);
    const chosen = pick(picks);
    const move = randomMove(job);
    return {
      styleText: chosen ? chosen.text : "",
      styleLabel: chosen
        ? isExpansionLane(lane)
          ? `Expansion lane · ${lane} · shuffled`
          : `Track ${job === "original" ? 1 : 2} · ${lane} · shuffled`
        : "No library prompt — type your own",
      moveText: move ? move.layer : "",
      moveLabel: move ? `Technical move · ${move.move.name}` : "",
      slotDetail: pick(SLOT_DETAILS) ?? "",
    };
  }

  function randomLyricsPick(job: JobType, lane: string): Partial<BuildState> {
    if (Math.random() < 0.65) {
      return {
        lyricsTopic: lane,
        lyricsText: buildV6LyricsMap(lane, job),
        lyricsLabel: `v6 detailed structure · ${lane}`,
      };
    }
    const t = templateFor(lane, job);
    // The bank's 46 lyrics templates cover the 21 verified lanes (plus
    // two utility topics) — the 20 expansion lanes have NO bank
    // template, so templateFor returns empty text for them. Landing
    // here with an empty map would silently wipe the Lyrics block on
    // Shuffle / Randomize All (measured: 40 of 82 lane×job combos).
    // Fall back to the lane's v6 detailed structure instead.
    if (!t.text) {
      return {
        lyricsTopic: lane,
        lyricsText: buildV6LyricsMap(lane, job),
        lyricsLabel: `v6 detailed structure · ${lane} · shuffled`,
      };
    }
    return {
      lyricsTopic: lane,
      lyricsText: t.text,
      lyricsLabel: `${t.label} · shuffled`,
    };
  }

  function shuffleLaneStyle() {
    // Style shuffle touches lane/style/move/slot only — the lyrics map
    // has its own shuffle and is never silently replaced, and neither
    // is the Simple-box prompt (defect found in the round-2 sweep:
    // repick() also re-picks the Simple prompt for the new lane, so
    // this shuffle used to swap the Simple text without saying so).
    const lane = lockedLane ?? pick(ALL_LANES) ?? s.lane;
    setS((prev) => ({
      ...repick(prev, prev.job, lane),
      ...randomStylePick(prev.job, lane),
      lyricsTopic: prev.lyricsTopic,
      lyricsText: prev.lyricsText,
      lyricsLabel: prev.lyricsLabel,
      simpleText: prev.simpleText,
      simpleLabel: prev.simpleLabel,
    }));
  }

  function shuffleMove() {
    const move = randomMove(s.job);
    patch({
      moveText: move ? move.layer : "",
      moveLabel: move ? `Technical move · ${move.move.name}` : "",
    });
  }

  function shuffleExclude() {
    const sel = randomExcludeSel(s.job);
    patch({ excludeSel: sel, excludeText: joinExclude(sel), excludeCustom: false });
  }

  function shuffleLyrics() {
    patch(randomLyricsPick(s.job, s.lane));
  }

  function shuffleSettings() {
    patch(randomSettings(s.job));
  }

  function shuffleSimple() {
    const lane = lockedLane ?? s.lane;
    // Shuffle draws from both the Simple paragraphs and the Remix
    // Templates pinned to this lane — remix templates are original
    // directive + compressed-full-structure paragraphs for fast remixes.
    if (Math.random() < 0.5) {
      const remix = randomRemix(s.job, lane) ?? randomRemix(s.job);
      if (remix) {
        patch({
          simpleText: remix.text,
          simpleLabel: `Remix Template · ${remix.title} · ${remix.family} · shuffled`,
        });
        return;
      }
    }
    const chosen =
      randomSimple(s.job, lane) ?? randomSimple(s.job);
    if (chosen) {
      patch({
        simpleText: chosen.text,
        simpleLabel: `Simple box · ${chosen.title} · ${chosen.source} · shuffled`,
      });
    }
  }

  function randomizeAll() {
    setS((prev) => {
      const lane = lockedLane ?? pick(ALL_LANES) ?? prev.lane;
      const base = repick(prev, prev.job, lane);
      const sel = randomExcludeSel(prev.job);
      // Randomize All also rotates through Remix Templates for the
      // Simple block, so a full random package can land on a remix
      // template (directive + compressed full structure) for this lane.
      const remix = Math.random() < 0.5 ? randomRemix(prev.job, lane) : undefined;
      const simple = remix ?? randomSimple(prev.job, lane);
      const simpleLabel = remix
        ? `Remix Template · ${remix.title} · ${remix.family} · shuffled`
        : simple
          ? `Simple box · ${simple.title} · ${simple.source} · shuffled`
          : undefined;
      return {
        ...base,
        ...randomStylePick(prev.job, lane),
        ...randomLyricsPick(prev.job, lane),
        excludeSel: sel,
        excludeText: joinExclude(sel),
        excludeCustom: false,
        ...randomSettings(prev.job),
        ...(simple && simpleLabel
          ? {
              simpleText: simple.text,
              simpleLabel,
            }
          : {}),
      };
    });
    setSavedMsg(null);
  }

  // --- Suno handoff checklist --------------------------------------
  // The phone workflow is: build here, switch to Suno, paste four
  // blocks in order, switch back. Losing your place mid-handoff is
  // the main source of wrong-field pastes. The checklist walks the
  // blocks in Suno's order, copying + checking each one off. Done
  // state is fingerprinted to the current package text — editing any
  // block un-checks the list rather than leaving stale ticks lying.
  const handoffKey = `${s.job}|${assembledStyle}|${s.excludeText}|${s.lyricsText}|${settings}`;
  const [handoff, setHandoff] = useState<{
    key: string;
    done: ReadonlySet<number>;
  }>({ key: "", done: new Set() });
  const handoffDone =
    handoff.key === handoffKey ? handoff.done : new Set<number>();
  const handoffSteps: {
    label: string;
    hint: string;
    text?: string;
  }[] = [
    {
      label:
        s.job === "preserve"
          ? "In Suno: pick Extend and upload your beat"
          : "In Suno: pick Create",
      hint:
        s.job === "preserve"
          ? "Extend is the only route that keeps your original audio. Upload first, then paste the blocks below in order."
          : "A fresh generation from the blocks below — nothing to upload.",
    },
    { label: "Style", hint: "Paste into the Style field.", text: assembledStyle },
    { label: "Exclude", hint: "Paste into the Exclude / negative field.", text: s.excludeText },
    { label: "Lyrics map", hint: "Paste into the Lyrics field.", text: s.lyricsText },
    { label: "Settings", hint: settings, text: settings },
  ];
  // --- Pre-flight check ---------------------------------------------
  // One glance before the Suno handoff: is this package actually
  // ready? Every rule checked here already exists somewhere in the
  // app (the lock line, the [End] close, the field caps, Variety 0,
  // his tested settings bands) — this card just gathers them into a
  // single pass/fix list so a bad block is caught here, not in Suno.
  const inBand = (v: number, lo: number, hi: number) => v >= lo && v <= hi;
  const settingsInBand =
    s.job === "preserve"
      ? inBand(s.weirdness, 20, 30) &&
        inBand(s.styleInfluence, 65, 75) &&
        inBand(s.audioInfluence, 75, 85)
      : inBand(s.weirdness, 20, 40) && inBand(s.styleInfluence, 65, 85);
  const preflight: { ok: boolean; label: string }[] = [
    {
      ok: assembledStyle.trim().length > 0 && !styleTruncated,
      label: styleTruncated
        ? `Style runs past the ${STYLE_LIMIT} cap — Copy/Save would carry a cut version`
        : "Style has text and fits the 1,000 cap",
    },
    ...(s.job === "preserve"
      ? [
          {
            ok: !lockMissing,
            label: "Preserve lock line is in the Style block",
          },
          {
            ok: !simpleLockMissing,
            label: "Preserve lock line is in the Simple box prompt",
          },
        ]
      : []),
    {
      ok: s.lyricsText.trim().length > 0 && s.lyricsText.length <= LYRICS_LIMIT,
      label: "Lyrics map has text and fits the 5,000 cap",
    },
    {
      ok: lyricsEndsOk,
      label: "Lyrics map closes with [End]",
    },
    {
      ok: s.excludeText.trim().length > 0,
      label: "Exclude has text (negatives live here, not in Style)",
    },
    {
      ok: s.variety === 0,
      label:
        s.variety === 0
          ? "Variety is 0 — Suno runs your Style text word-for-word"
          : "Variety is above 0 — Suno may rewrite your Style text",
    },
    {
      ok: settingsInBand,
      label: settingsInBand
        ? "Settings sit inside his tested bands"
        : "Settings sit outside his tested bands (a deliberate bend is fine — this is a flag, not a block)",
    },
  ];
  const preflightOk = preflight.every((c) => c.ok);

  async function handoffCopy(idx: number, text?: string) {
    if (text !== undefined) {
      const ok = await copyText(text);
      if (!ok) return;
    }
    setHandoff({
      key: handoffKey,
      done: new Set([...handoffDone, idx]),
    });
  }

  const queryClient = useQueryClient();
  const saveTake = useMutation({
    mutationFn: () =>
      api.createTake({
        name:
          takeName.trim() ||
          `${s.lane} — ${s.job === "preserve" ? "Preserve" : "Original"}`,
        lane: s.lane,
        job_type: s.job,
        style: assembledStyle,
        exclude_text: s.excludeText,
        lyrics: s.lyricsText,
        settings,
      }),
    onSuccess: () => {
      // Refetch Takes immediately — the Takes screen stays mounted behind
      // the tab bar, so it must not be left showing a stale list.
      queryClient.invalidateQueries({ queryKey: ["takes"] });
      setSavedMsg("Saved. Find it in Takes — mark it winner or miss there.");
      setTakeName("");
    },
  });

  return (
    <div>
      <h2 className="font-display text-2xl">Build a package</h2>

      {draftRestored && (
        <div className="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-3">
          <p className="text-sm leading-relaxed text-[var(--dim)]">
            Draft restored from this device — the package you were last
            building, exactly where you left it. It keeps saving here as
            you work.
          </p>
          <button
            type="button"
            onClick={() => {
              setS(defaultBuildState());
              setDraftRestored(false);
              setSavedMsg(null);
            }}
            className="min-h-[44px] rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 text-sm font-bold"
          >
            Start fresh
          </button>
        </div>
      )}

      {analysis && (
        <div className="mt-3 rounded-[var(--radius)] border border-[var(--accent)] bg-[var(--surface)] px-4 py-3">
          <p className="font-display text-base">
            Analysis loaded: {analysis.suggestedLane} · {analysis.pocketLabel}
          </p>
          <p className="mt-1 text-sm leading-relaxed text-[var(--dim)]">
            From {analysis.fileName}. Shuffle and Randomize All stay inside
            the measured lane while this is loaded.
          </p>
          <button
            type="button"
            onClick={onClearAnalysis}
            className="mt-2 min-h-[44px] rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 text-sm font-bold"
          >
            Release lane lock
          </button>
        </div>
      )}

      <button
        type="button"
        onClick={randomizeAll}
        aria-label="Randomize all sections"
        className="mt-4 min-h-[56px] w-full rounded-md bg-[var(--accent)] text-lg font-bold text-[var(--accent-ink)]"
      >
        Randomize All
      </button>
      <p className="mt-2 text-sm text-[var(--dim)]">
        One tap assembles a full random package from the real banks —
        lane prompt, technical move, slot detail, exclude combo, lyrics
        map, settings inside the tested bands.
        {s.job === "preserve"
          ? " Preserve keeps the lock line, always."
          : ""}
      </p>

      {/* Job type */}
      <div className="mt-4">
        <SegControl<JobType>
          label="Job type"
          value={s.job}
          onChange={changeJob}
          options={[
            { value: "original", label: "Original" },
            { value: "preserve", label: "Preserve" },
          ]}
        />
      </div>

      {s.job === "preserve" ? (
        <div className="mt-3 rounded-[var(--radius)] border border-[var(--accent)] bg-[var(--surface)] px-4 py-3">
          <p className="font-display text-base">
            Route: Extend — this is what keeps your original audio.
          </p>
          <p className="mt-1 text-sm leading-relaxed text-[var(--dim)]">
            Everything before the continuation point stays your real
            recording. Cover, Sample, Mashup, Inspo and Remaster regenerate
            the audio — never use them on a preserve job. The sample, the
            sampled vocals exactly as performed, and the main melody stay
            untouched; drums, 808s, texture and transitions are the canvas.
          </p>
        </div>
      ) : (
        <p className="mt-3 text-sm text-[var(--dim)]">
          Route: Create. A fresh beat from the library — nothing to protect,
          so the whole prompt is yours to bend.
        </p>
      )}

      {/* Lane */}
      <div className="mt-4">
        <label htmlFor="build-lane" className="font-display text-sm uppercase tracking-wider">
          Lane
        </label>
        <select
          id="build-lane"
          value={s.lane}
          onChange={(e) => changeLane(e.target.value)}
          className={`${selectCls} mt-1.5`}
        >
          {ALL_LANES.map((l) => (
            <option key={l} value={l}>
              {l}
            </option>
          ))}
        </select>
        {laneFramework && (
          <div className="mt-3 rounded-md border border-[var(--border)] bg-[var(--surface)] px-3 py-3">
            <p className="font-display text-sm uppercase tracking-wider">
              Framework — {laneFramework.name}
            </p>
            <p className="mt-1 text-sm leading-relaxed text-[var(--dim)]">
              {laneFramework.layout}. Builds: {laneFramework.build}. Drops:{" "}
              {laneFramework.drop}. Breakdown: {laneFramework.breakdown}.
              Signature: {laneFramework.signature}.
            </p>
            {laneSource && (
              <p className="mt-1 text-xs text-[var(--dim)]">
                {laneSource.region} · {laneSource.sourceNote}
              </p>
            )}
            <p className="mt-1 text-xs text-[var(--dim)]">
              The Lyrics map, Simple prompt and remix templates for this
              lane are generated from this framework.
            </p>
          </div>
        )}
      </div>

      <div className="mt-5 space-y-4">
        {/* STYLE */}
        <BlockShell
          title="Style"
          text={assembledStyle}
          limit={STYLE_LIMIT}
          onShuffle={shuffleLaneStyle}
          shuffleLabel="Shuffle lane and style prompt"
        >
          <p className="text-xs uppercase tracking-wide text-[var(--dim)]">
            Base prompt · {s.styleLabel}
          </p>
          <label htmlFor="build-style" className="sr-only">
            Style prompt text
          </label>
          <textarea
            id="build-style"
            rows={5}
            value={s.styleText}
            onChange={(e) =>
              patch({ styleText: e.target.value, styleLabel: "Edited by hand" })
            }
            className={`${textareaCls} mt-2`}
          />
          {lockMissing && (
            <div className="mt-3 rounded-md border border-[var(--danger)] bg-[var(--surface-alt)] px-3 py-3">
              <p className="text-base font-bold text-[var(--danger)]">
                Lock line missing.
              </p>
              <p className="mt-1 text-sm leading-relaxed">
                A Preserve style block must carry: “{LOCK_LINE}”. Track 2
                prompts already contain it — or add it now.
              </p>
              <button
                type="button"
                onClick={() =>
                  patch({
                    styleText: `${LOCK_LINE}. ${s.styleText}`,
                    styleLabel: "Edited by hand — lock added",
                  })
                }
                className="mt-2 min-h-[44px] rounded-md bg-[var(--accent)] px-4 font-bold text-[var(--accent-ink)]"
              >
                Add lock line
              </button>
            </div>
          )}
          {styleTruncated && (
            <div className="mt-3 rounded-md border border-[var(--danger)] bg-[var(--surface-alt)] px-3 py-3">
              <p className="text-base font-bold text-[var(--danger)]">
                Style is over the {STYLE_LIMIT} cap — Copy and Save carry
                a cut version.
              </p>
              <p className="mt-1 text-sm leading-relaxed">
                The full layered text runs {assembledFull.length}{" "}
                characters. Layers are dropped first, then the base prompt
                itself is cut at {STYLE_LIMIT} — so what Suno would get
                is not the full text in the box above. Trim the base
                prompt (or drop a layer) until this warning clears to
                control exactly what Suno runs.
              </p>
            </div>
          )}
          {/* LAYERS — technical move + slot detail fold into the Style
              output above (the copy/save text). Base stays untouched. */}
          <div className="mt-4 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-3 py-3">
            <p className="font-display text-sm uppercase tracking-wider">
              Layers — v6 assembly
            </p>
            <p className="mt-1 text-sm text-[var(--dim)]">
              The Style output layers the base prompt with a technical move
              and a slot detail. Copy and Save use the layered text.
            </p>
            <label
              htmlFor="build-move"
              className="mt-3 block text-sm text-[var(--dim)]"
            >
              Technical move (Ammo bank)
            </label>
            <div className="mt-1 flex gap-2">
              <select
                id="build-move"
                value={s.moveLabel.replace("Technical move · ", "")}
                onChange={(e) => {
                  const mv = ammo.technical_moves.find(
                    (m) => m.name === e.target.value,
                  );
                  patch({
                    moveText: mv ? moveLayerText(mv, s.job) : "",
                    moveLabel: mv ? `Technical move · ${mv.name}` : "",
                  });
                }}
                className={`${selectCls} flex-1`}
              >
                <option value="">No move layer</option>
                {ammo.technical_moves.map((m) => (
                  <option key={m.name} value={m.name}>
                    {m.name}
                  </option>
                ))}
              </select>
              <button
                type="button"
                onClick={shuffleMove}
                aria-label="Shuffle technical move"
                className="min-h-[52px] shrink-0 rounded-md border border-[var(--accent)] px-4 font-bold text-[var(--accent)]"
              >
                Shuffle
              </button>
            </div>
            <label
              htmlFor="build-slot"
