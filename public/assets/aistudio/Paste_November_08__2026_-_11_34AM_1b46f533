// Beat analysis — real measurement of the user's actual audio file,
// computed on-device with the Web Audio API and plain DSP. Nothing is
// uploaded anywhere; the file never leaves the browser.
//
// What is measured: duration, tempo (onset-flux autocorrelation), key
// estimate (chromagram + Krumhansl profiles), loudness (RMS / peak),
// low-end share, brightness (spectral centroid), and hit density
// (onsets per second). These are estimates from signal math, labeled as
// such in the UI — never presented as a human engineer's ear.

import { LOCK_LINE } from "./bank";

export interface BeatAnalysis {
  fileName: string;
  durationSec: number;
  bpm: number | null;
  bpmConfidence: "high" | "medium" | "low" | null;
  keyName: string | null;
  keyClear: boolean;
  rmsDb: number;
  peakDb: number;
  lowShare: number; // 0..1 of spectral energy under ~160 Hz
  centroidHz: number;
  onsetRate: number; // onsets per second
  suggestedLane: string;
  pocketLabel: string;
  promptPreserve: string;
  promptOriginal: string;
  /**
   * What the sample says — NEVER produced by the analyzer itself.
   * This analyzer measures signal only; it has no transcription
   * channel, so by default it makes out no words and the UI says
   * exactly that. These fields are filled only when Boo enters words
   * he heard himself, labeled "clear" or "fragment". Nothing here is
   * ever invented, completed, or guessed.
   */
  sampleWordsText?: string;
  sampleWordsKind?: "clear" | "fragment";
}

const NOTE_NAMES = [
  "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B",
];

const MAJOR_PROFILE = [
  6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88,
];
const MINOR_PROFILE = [
  6.33, 2.68, 3.52, 5.38, 2.6, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17,
];

/** Iterative radix-2 FFT, in place. Length must be a power of two. */
function fft(re: Float64Array, im: Float64Array): void {
  const n = re.length;
  for (let i = 1, j = 0; i < n; i++) {
    let bit = n >> 1;
    for (; j & bit; bit >>= 1) j ^= bit;
    j ^= bit;
    if (i < j) {
      const tr = re[i] ?? 0;
      re[i] = re[j] ?? 0;
      re[j] = tr;
      const ti = im[i] ?? 0;
      im[i] = im[j] ?? 0;
      im[j] = ti;
    }
  }
  for (let len = 2; len <= n; len <<= 1) {
    const ang = (-2 * Math.PI) / len;
    const wr = Math.cos(ang);
    const wi = Math.sin(ang);
    const half = len >> 1;
    for (let i = 0; i < n; i += len) {
      let cwr = 1;
      let cwi = 0;
      for (let k = 0; k < half; k++) {
        const a = i + k;
        const b = a + half;
        const br = re[b] ?? 0;
        const bi = im[b] ?? 0;
        const vr = br * cwr - bi * cwi;
        const vi = br * cwi + bi * cwr;
        re[b] = (re[a] ?? 0) - vr;
        im[b] = (im[a] ?? 0) - vi;
        re[a] = (re[a] ?? 0) + vr;
        im[a] = (im[a] ?? 0) + vi;
        const nwr = cwr * wr - cwi * wi;
        cwi = cwr * wi + cwi * wr;
        cwr = nwr;
      }
    }
  }
}

function correlate(chroma: number[], profile: number[], root: number): number {
  let meanC = 0;
  let meanP = 0;
  for (let i = 0; i < 12; i++) {
    meanC += chroma[i] ?? 0;
    meanP += profile[i] ?? 0;
  }
  meanC /= 12;
  meanP /= 12;
  let num = 0;
  let dc = 0;
  let dp = 0;
  for (let i = 0; i < 12; i++) {
    const c = (chroma[i] ?? 0) - meanC;
    const p = (profile[(i - root + 12) % 12] ?? 0) - meanP;
    num += c * p;
    dc += c * c;
    dp += p * p;
  }
  const den = Math.sqrt(dc * dp);
  return den > 0 ? num / den : 0;
}

function estimateKey(chromaRaw: number[]): { name: string | null; clear: boolean } {
  const sum = chromaRaw.reduce((a, b) => a + b, 0);
  if (sum <= 0) return { name: null, clear: false };
  const chroma = chromaRaw.map((v) => v / sum);
  let best = -Infinity;
  let second = -Infinity;
  let bestName: string | null = null;
  let bestRoot = -1;
  let bestMode: "major" | "minor" = "major";
  for (let root = 0; root < 12; root++) {
    const maj = correlate(chroma, MAJOR_PROFILE, root);
    const min = correlate(chroma, MINOR_PROFILE, root);
    for (const [score, mode] of [
      [maj, "major"],
      [min, "minor"],
    ] as const) {
      if (score > best) {
        second = best;
        best = score;
        bestName = `${NOTE_NAMES[root] ?? "?"} ${mode}`;
        bestRoot = root;
        bestMode = mode;
      } else if (score > second) {
        second = score;
      }
    }
  }
  // Naming threshold is 0.55, not a bare correlation win. The chroma
  // reaching this function comes from the long-window chroma pass
  // (8192-point FFT, fractional pitch-class assignment, per-frame
  // normalization, bin-shape bias correction — see measureAudioBuffer);
  // measured against synthetic ground truth with that pipeline, real
  // tonal loops correlate at ~0.64–0.91 with their true key while
  // white noise sits at ~0.50 — and noise-like audio is refused
  // earlier by the spectral-flatness gate regardless of correlation.
  // Below 0.55 the honest answer is "Unread" — never a dressed-up
  // guess in the prompt.
  if (bestName === null || best < 0.55) return { name: null, clear: false };
  let clear = best - second > 0.08;
  if (clear && bestRoot >= 0) {
    // Third-evidence guard: a "clear" major/minor claim needs the
    // winning mode's third actually present in the chroma, ahead of
    // the opposite third. Bare-fifth material (root + fifth, no
    // third — power-chord 808/sample loops) and fifth-led voicings
    // with a buried third are mode-underdetermined: the profile fit
    // still names a key, but it must not call the read clear.
    // Measured: an A+E power chord and a fifth-led E voicing with a
    // quiet minor third both came out "(clear)" before this guard;
    // true triads carry their third strongly and stay clear.
    const winThird = chroma[(bestRoot + (bestMode === "major" ? 4 : 3)) % 12] ?? 0;
    const oppThird = chroma[(bestRoot + (bestMode === "major" ? 3 : 4)) % 12] ?? 0;
    const thirdTotal = winThird + oppThird;
    if (thirdTotal <= 0 || winThird / thirdTotal < 0.6) clear = false;
    // Relative-pair guard: a major key and its relative minor share
    // the same pitch set, so an aggregate chroma cannot separate
    // them when both profiles fit nearly equally — the classic case
    // is a loop cycling Am–F–C–G, whose pitch content is identical
    // in A minor and C major. Measured margins: that progression's
    // relative pair sits 0.08 apart, while true single-key triads
    // separate their relative by 0.27–0.63. Within 0.12 the centre
    // is contested, so the read is named but not called clear.
    if (clear) {
      const relRoot = bestMode === "major" ? (bestRoot + 9) % 12 : (bestRoot + 3) % 12;
      const relScore = correlate(
        chroma,
        bestMode === "major" ? MINOR_PROFILE : MAJOR_PROFILE,
        relRoot,
      );
      if (best - relScore < 0.12) clear = false;
    }
  }
  return { name: bestName, clear };
}

export function suggestLane(
  bpm: number | null,
  centroidHz: number,
  onsetRate: number,
): string {
  if (bpm === null) return "Trap";
  if (bpm <= 78) return "Chopped & screwed";
  if (bpm <= 99) return centroidHz < 2200 ? "Jazz rap / lo-fi" : "Boom bap";
  if (bpm <= 117)
    return centroidHz > 3400 ? "West Coast / G-funk" : "Soul-sample hip-hop";
  if (bpm <= 131) return onsetRate < 1.6 ? "Trap soul" : "Down South / Southern trap";
  if (bpm <= 152) return "Trap";
  if (bpm <= 170)
    return centroidHz > 3400 ? "Florida fast" : "Detroit scam-rap pocket";
  return "Tread";
}

function lowDesc(lowShare: number): string {
  if (lowShare >= 0.45) return "heavy low end, long 808 weight already in the pocket";
  if (lowShare >= 0.3) return "solid low end under the sample";
  return "lean low end, room for sub and 808 support";
}

function brightDesc(centroidHz: number): string {
  if (centroidHz >= 3800) return "bright top end, hats and air up front";
  if (centroidHz >= 2400) return "balanced top end";
  return "dark, dusty top end, rolled-off highs";
}

function densityDesc(onsetRate: number): string {
  if (onsetRate >= 3.5) return "busy hit density, drums stay active";
  if (onsetRate >= 1.8) return "steady hit density";
  return "sparse hit density, lots of open space";
}

export async function analyzeBeat(file: File): Promise<BeatAnalysis> {
  const Ctor =
    window.AudioContext ??
    (window as unknown as { webkitAudioContext?: typeof AudioContext })
      .webkitAudioContext;
  if (!Ctor) throw new Error("This browser cannot decode audio here.");
  const ctx = new Ctor();
  try {
    const raw = await file.arrayBuffer();
    const buffer = await ctx.decodeAudioData(raw.slice(0));
    return measureAudioBuffer(file.name, buffer);
  } finally {
    void ctx.close().catch(() => undefined);
  }
}

export function measureAudioBuffer(fileName: string, buffer: AudioBuffer): BeatAnalysis {
  const sr = buffer.sampleRate;
  const maxSamples = Math.min(buffer.length, Math.floor(sr * 240));
  const mono = new Float32Array(maxSamples);
  const channels = buffer.numberOfChannels;
  for (let c = 0; c < channels; c++) {
    const data = buffer.getChannelData(c);
    for (let i = 0; i < maxSamples; i++) {
      mono[i] = (mono[i] ?? 0) + (data[i] ?? 0) / channels;
    }
  }

  // Loudness from the time domain.
  let sumSq = 0;
  let peak = 0;
  for (let i = 0; i < maxSamples; i++) {
    const v = mono[i] ?? 0;
    sumSq += v * v;
    const a = Math.abs(v);
    if (a > peak) peak = a;
  }
  const rms = Math.sqrt(sumSq / Math.max(1, maxSamples));
  const rmsDb = rms > 0 ? 20 * Math.log10(rms) : -Infinity;
  const peakDb = peak > 0 ? 20 * Math.log10(peak) : -Infinity;

  // Frame-by-frame spectral features.
  const WIN = 2048;
  const HOP = 512;
  const fps = sr / HOP;
  const frameCount = Math.max(0, Math.floor((maxSamples - WIN) / HOP) + 1);
  const flux = new Float32Array(frameCount);
  const prevMag = new Float64Array(WIN / 2);
  // Per-frame tonal-band magnitude, gated after the pass: a key is
  // only read when frames carrying real tonal-band energy are
  // sustained (see the gate below), so a lone transient or a quiet
  // tail cannot name a key by itself. The chroma itself comes from a
  // separate long-window pass further down — pitch-class resolution
  // at this window size is too coarse in the low-mid register.
  const frameBandMag = new Float32Array(frameCount);
  // Per-frame spectral flatness over the tonal band (geometric mean /
  // arithmetic mean of bin magnitudes). Tonal frames are peaky
  // (flatness near 0); noise, hiss and texture frames are flat
  // (0.55–0.9 measured). The key gate below refuses to name a key
  // when the evidence frames are noise-flat — a chroma correlation
  // alone cannot tell a key from a noise bed, because FFT bins vote
  // unevenly across pitch classes (21 bins land on C, 9 on C# in this
  // band), which hands noise a lopsided chroma that mimics a profile.
  const frameFlat = new Float32Array(frameCount);
  let lowEnergy = 0;
  let totalEnergy = 0;
  let centroidWeighted = 0;
  let centroidWeight = 0;
  const re = new Float64Array(WIN);
  const im = new Float64Array(WIN);
  const hann = new Float64Array(WIN);
  for (let i = 0; i < WIN; i++) {
    hann[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (WIN - 1));
  }

  for (let f = 0; f < frameCount; f++) {
    const start = f * HOP;
    for (let i = 0; i < WIN; i++) {
      re[i] = (mono[start + i] ?? 0) * (hann[i] ?? 0);
      im[i] = 0;
    }
    fft(re, im);
    let fluxSum = 0;
    let frameEnergy = 0;
    let frameCentroidNum = 0;
    let frameBandMagSum = 0;
    let bandLogSum = 0;
    let bandBinCount = 0;
    for (let k = 1; k < WIN / 2; k++) {
      const mag = Math.hypot(re[k] ?? 0, im[k] ?? 0);
      const diff = mag - (prevMag[k] ?? 0);
      if (diff > 0) fluxSum += diff;
      prevMag[k] = mag;
      const freq = (k * sr) / WIN;
      const e = mag * mag;
      frameEnergy += e;
      frameCentroidNum += freq * e;
      totalEnergy += e;
      if (freq < 160) lowEnergy += e;
      if (freq >= 55 && freq <= 4200) {
        frameBandMagSum += mag;
        bandLogSum += Math.log(mag + 1e-12);
        bandBinCount++;
      }
    }
    flux[f] = fluxSum;
    frameBandMag[f] = frameBandMagSum;
    frameFlat[f] =
      bandBinCount > 0 && frameBandMagSum > 0
        ? Math.exp(bandLogSum / bandBinCount) / (frameBandMagSum / bandBinCount)
        : 1;
    if (frameEnergy > 0) {
      centroidWeighted += (frameCentroidNum / frameEnergy) * frameEnergy;
      centroidWeight += frameEnergy;
    }
  }

  const centroidHz = centroidWeight > 0 ? centroidWeighted / centroidWeight : 0;
  const lowShare = totalEnergy > 0 ? lowEnergy / totalEnergy : 0;

  // Chroma pass — a dedicated long-window FFT (8192) over the same
  // audio, hop 4096, band 100–4200 Hz. Pitch-class resolution of the
  // 2048 window above is too coarse where harmony lives: its 21.5 Hz
  // bins are ~1.6 semitones wide at 165 Hz, and a tone sitting
  // between two bins votes for the wrong pitch classes entirely —
  // measured against synthetic ground truth, an E3 tone's energy
  // landed on F and D with none on E, and root-heavy E minor,
  // E major and B minor chords all read as F major. At 8192 the bins
  // are 5.4 Hz (~0.3 semitones at 165 Hz). Each bin's POWER
  // (magnitude squared — tonal peaks concentrate power while
  // broadband energy spreads it) is split fractionally between the
  // two nearest pitch classes by log-frequency distance.
  const CWIN = 8192;
  const CHOP = 4096;
  const cFrameCount = Math.max(0, Math.floor((maxSamples - CWIN) / CHOP) + 1);
  const cChromaFrames = new Float32Array(cFrameCount * 12);
  const cFrameBandMag = new Float32Array(cFrameCount);
  {
    const cre = new Float64Array(CWIN);
    const cim = new Float64Array(CWIN);
    const chann = new Float64Array(CWIN);
    for (let i = 0; i < CWIN; i++) {
      chann[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (CWIN - 1));
    }
    for (let f = 0; f < cFrameCount; f++) {
      const start = f * CHOP;
      for (let i = 0; i < CWIN; i++) {
        cre[i] = (mono[start + i] ?? 0) * (chann[i] ?? 0);
        cim[i] = 0;
      }
      fft(cre, cim);
      let bandMag = 0;
      for (let k = 1; k < CWIN / 2; k++) {
        const freq = (k * sr) / CWIN;
        if (freq < 100 || freq > 4200) continue;
        const mag = Math.hypot(cre[k] ?? 0, cim[k] ?? 0);
        bandMag += mag;
        const e = mag * mag;
        const midiF = 69 + 12 * Math.log2(freq / 440);
        const lo = Math.floor(midiF);
        const frac = midiF - lo;
        const pcLo = ((lo % 12) + 12) % 12;
        const pcHi = (pcLo + 1) % 12;
        const idxLo = f * 12 + pcLo;
        const idxHi = f * 12 + pcHi;
        cChromaFrames[idxLo] = (cChromaFrames[idxLo] ?? 0) + e * (1 - frac);
        cChromaFrames[idxHi] = (cChromaFrames[idxHi] ?? 0) + e * frac;
      }
      cFrameBandMag[f] = bandMag;
    }
  }

  // Onset count: flux peaks above an adaptive threshold.
  let onsetCount = 0;
  let fluxMean = 0;
  for (let i = 0; i < frameCount; i++) fluxMean += flux[i] ?? 0;
  fluxMean = frameCount > 0 ? fluxMean / frameCount : 0;
  const threshold = fluxMean * 1.6;
  for (let i = 2; i < frameCount - 2; i++) {
    const v = flux[i] ?? 0;
    if (
      v > threshold &&
      v >= (flux[i - 1] ?? 0) &&
      v > (flux[i + 1] ?? 0)
    ) {
      onsetCount++;
      i += 2;
    }
  }
  const durationSec = buffer.duration;
  // Onsets are counted inside the analyzed window only (the first
  // maxSamples), so the rate must divide by the window length — for a
  // file longer than the window, dividing by the full duration
  // understates the density and mislabels the prompt (verified: a
  // 6-minute file read 1.33/s against a true ~2.0/s).
  const analyzedSec = sr > 0 ? maxSamples / sr : durationSec;
  const onsetRate = analyzedSec > 0 ? onsetCount / analyzedSec : 0;

  // Tempo: autocorrelation of the onset-flux envelope.
  let bpm: number | null = null;
  let bpmConfidence: BeatAnalysis["bpmConfidence"] = null;
  if (frameCount > Math.floor(fps * 4)) {
    const mean = fluxMean;
    const centered = new Float64Array(frameCount);
    for (let i = 0; i < frameCount; i++) centered[i] = (flux[i] ?? 0) - mean;
    let r0 = 0;
    for (let i = 0; i < frameCount; i++) r0 += (centered[i] ?? 0) ** 2;
    if (r0 > 0) {
      const minLag = Math.max(2, Math.floor((60 / 180) * fps));
      const maxLag = Math.min(frameCount - 2, Math.ceil((60 / 55) * fps));
      const ac = new Float64Array(maxLag + 2);
      for (let lag = minLag; lag <= maxLag; lag++) {
        let s = 0;
        for (let i = 0; i + lag < frameCount; i++) {
          s += (centered[i] ?? 0) * (centered[i + lag] ?? 0);
        }
        ac[lag] = s / r0;
      }
      let bestLag = -1;
      let bestVal = -Infinity;
      for (let lag = minLag; lag <= maxLag; lag++) {
        if ((ac[lag] ?? -Infinity) > bestVal) {
          bestVal = ac[lag] ?? 0;
          bestLag = lag;
        }
      }
      if (bestLag > 0 && bestVal >= 0.15) {
        // Parabolic interpolation for a finer lag.
        const a = ac[bestLag - 1] ?? bestVal;
        const b = bestVal;
        const c = ac[bestLag + 1] ?? bestVal;
        const denom = a - 2 * b + c;
        const shift = denom !== 0 ? (0.5 * (a - c)) / denom : 0;
        let lag = bestLag + Math.max(-1, Math.min(1, shift));
        let val = bestVal;
        // Octave fold: prefer the written (double) tempo for slow feels
        // when its correlation is nearly as strong.
        const halfLag = Math.round(lag / 2);
        if (
          60 / (lag / fps) < 70 &&
          halfLag >= minLag &&
          (ac[halfLag] ?? 0) >= 0.88 * val
        ) {
          lag = halfLag;
          val = ac[halfLag] ?? val;
        }
        bpm = Math.round((60 / (lag / fps)) * 10) / 10;
        bpmConfidence = val >= 0.45 ? "high" : val >= 0.28 ? "medium" : "low";
      }
    }
  }

  // Key evidence gate: only frames whose tonal-band magnitude reaches
  // 5% of the strongest frame count as tonal evidence, and a key is
  // named only when that evidence is sustained — at least 3 seconds of
  // tonal frames covering at least 20% of the analyzed window.
  // Measured against ground truth: a single click produces ~4 tonal
  // frames (0.1s) yet correlates 0.62 with a profile, so without this
  // gate a near-silent file gets a named "tonal center" in its prompt.
  let maxBand = 0;
  for (let f = 0; f < frameCount; f++) {
    const v = frameBandMag[f] ?? 0;
    if (v > maxBand) maxBand = v;
  }
  const gatedFlats: number[] = [];
  let tonalFrames = 0;
  if (maxBand > 0) {
    const floor = maxBand * 0.05;
    for (let f = 0; f < frameCount; f++) {
      if ((frameBandMag[f] ?? 0) < floor) continue;
      tonalFrames++;
      gatedFlats.push(frameFlat[f] ?? 1);
    }
  }
  // Chroma accumulation from the long-window pass: the same evidence
  // rule (frames under 5% of the strongest chroma frame do not vote)
  // and per-frame normalization, so a few loud transient frames (a
  // kick's spectral splatter) cannot outvote the sustained tonal body.
  const chroma = new Array<number>(12).fill(0);
  let cMaxBand = 0;
  for (let f = 0; f < cFrameCount; f++) {
    const v = cFrameBandMag[f] ?? 0;
    if (v > cMaxBand) cMaxBand = v;
  }
  if (cMaxBand > 0) {
    const cFloor = cMaxBand * 0.05;
    for (let f = 0; f < cFrameCount; f++) {
      if ((cFrameBandMag[f] ?? 0) < cFloor) continue;
      let frameSum = 0;
      for (let pc = 0; pc < 12; pc++) {
        frameSum += cChromaFrames[f * 12 + pc] ?? 0;
      }
      if (frameSum <= 0) continue;
      for (let pc = 0; pc < 12; pc++) {
        const idx = f * 12 + pc;
        chroma[pc] = (chroma[pc] ?? 0) + (cChromaFrames[idx] ?? 0) / frameSum;
      }
    }
    // Bin-shape bias correction: a flat spectrum does not vote evenly
    // across pitch classes — FFT bins land unevenly on pitch classes,
    // so uncorrected noise chroma leans toward key-shaped profiles
    // and can fake a key. Subtract the shape a flat spectrum would
    // produce under the chroma pass's own geometry and fractional
    // assignment (scaled to the measured total) before correlating;
    // what survives is the tonal excess above the noise floor shape.
    const binCounts = new Array<number>(12).fill(0);
    let totalBins = 0;
    for (let k = 1; k < CWIN / 2; k++) {
      const freq = (k * sr) / CWIN;
      if (freq < 100 || freq > 4200) continue;
      const midiF = 69 + 12 * Math.log2(freq / 440);
      const lo = Math.floor(midiF);
      const frac = midiF - lo;
      const pcLo = ((lo % 12) + 12) % 12;
      const pcHi = (pcLo + 1) % 12;
      binCounts[pcLo] = (binCounts[pcLo] ?? 0) + (1 - frac);
      binCounts[pcHi] = (binCounts[pcHi] ?? 0) + frac;
      totalBins++;
    }
    if (totalBins > 0) {
      const totalChroma = chroma.reduce((a, b) => a + b, 0);
      for (let pc = 0; pc < 12; pc++) {
        const expected = totalChroma * ((binCounts[pc] ?? 0) / totalBins);
        chroma[pc] = Math.max(0, (chroma[pc] ?? 0) - expected);
      }
    }
  }
  const tonalSec = fps > 0 ? tonalFrames / fps : 0;
  const tonalCoverage = frameCount > 0 ? tonalFrames / frameCount : 0;
  // Spectral-flatness gate: the median evidence frame must be peaky,
  // not noise-flat. Measured separation is wide — tonal loops sit at
  // ~0.00–0.01 median flatness; white noise ~0.85, pink noise ~0.60,
  // vinyl hiss ~0.67, drums-only ~0.60 — so 0.30 refuses the whole
  // noise family with room to spare on both sides.
  gatedFlats.sort((a, b) => a - b);
  const medianFlat =
    gatedFlats.length > 0
      ? (gatedFlats[Math.floor(gatedFlats.length / 2)] ?? 1)
      : 1;
  const key =
    tonalSec >= 3 && tonalCoverage >= 0.2 && medianFlat <= 0.3
      ? estimateKey(chroma)
      : { name: null, clear: false };
  const lane = suggestLane(bpm, centroidHz, onsetRate);
  const bpmText = bpm !== null ? `${Math.round(bpm)} BPM` : "tempo unread";
  const pocketLabel =
    bpm !== null && bpm >= 130 && bpm <= 152
      ? `${bpmText} · half-time feel ${Math.round(bpm / 2)}`
      : bpmText;
  const keyPart = key.name ? `, ${key.name} tonal center` : "";

  const promptPreserve =
    `${LOCK_LINE}. Enhance this ${lane} upload — ${pocketLabel}${keyPart}, ` +
    `${lowDesc(lowShare)}, ${brightDesc(centroidHz)}, ${densityDesc(onsetRate)}. ` +
    `Drums, 808s and texture are the canvas, spice only, sample stays lead.`;
  const promptOriginal =
    `${lane} instrumental, ${pocketLabel}${keyPart}, ${lowDesc(lowShare)}, ` +
    `${brightDesc(centroidHz)}, ${densityDesc(onsetRate)}, drums and 808s lead the arrangement.`;

  return {
    fileName,
    durationSec,
    bpm,
    bpmConfidence,
    keyName: key.name,
    keyClear: key.clear,
    rmsDb,
    peakDb,
    lowShare,
    centroidHz,
    onsetRate,
    suggestedLane: lane,
    pocketLabel,
    promptPreserve: promptPreserve.slice(0, 1000),
    promptOriginal: promptOriginal.slice(0, 1000),
  };
}

/**
 * Re-derive an analysis at a corrected tempo — the half/double fix.
 * Autocorrelation tempo reads can land an octave off on real loops
 * (a 70 BPM pocket with busy hats reads 140, a 150 read folds to 75);
 * when Boo hears the read is an octave out, this rebuilds the pocket
 * label, the suggested lane, and both style prompts from the SAME
 * other measurements at the corrected BPM. Key, loudness, low end,
 * brightness and density are tempo-independent and carry over
 * untouched; the confidence label carries over too (it described the
 * periodicity strength, which the octave correction does not change).
 */
export function withBpm(a: BeatAnalysis, bpm: number): BeatAnalysis {
  const lane = suggestLane(bpm, a.centroidHz, a.onsetRate);
  const bpmText = `${Math.round(bpm)} BPM`;
  const pocketLabel =
    bpm >= 130 && bpm <= 152
      ? `${bpmText} · half-time feel ${Math.round(bpm / 2)}`
      : bpmText;
  const base = { ...a, bpm, pocketLabel };
  return {
    ...base,
    suggestedLane: lane,
    promptPreserve: promptForLane(base, lane, "preserve"),
    promptOriginal: promptForLane(base, lane, "original"),
  };
}

export function fmtDb(v: number): string {
  if (!Number.isFinite(v)) return "—";
  return `${v.toFixed(1)} dB`;
}

export function fmtDuration(sec: number): string {
  // Round the total first: rounding the remainder alone can produce
  // "0:60" / "1:60" for lengths like 59.6s (measured defect).
  const total = Math.max(0, Math.round(sec));
  const m = Math.floor(total / 60);
  const s = total % 60;
  return `${m}:${s.toString().padStart(2, "0")}`;
}

/**
 * Rebuild the analysis style prompt for a DIFFERENT lane than the
 * measured one, from the same measurements — used by the lane-affinity
 * list in Analyze, where loading a runner-up lane must not carry a
 * style prompt that still names the measured lane in its text
 * (measured defect: the affinity "Load lane" buttons seeded
 * promptPreserve verbatim, whose text embeds the measured lane).
 */
export function promptForLane(
  a: Pick<
    BeatAnalysis,
    "pocketLabel" | "keyName" | "lowShare" | "centroidHz" | "onsetRate"
  >,
  lane: string,
  job: "original" | "preserve",
): string {
  const keyPart = a.keyName ? `, ${a.keyName} tonal center` : "";
  if (job === "preserve") {
    return (
      `${LOCK_LINE}. Enhance this ${lane} upload — ${a.pocketLabel}${keyPart}, ` +
      `${lowDesc(a.lowShare)}, ${brightDesc(a.centroidHz)}, ${densityDesc(a.onsetRate)}. ` +
      `Drums, 808s and texture are the canvas, spice only, sample stays lead.`
    ).slice(0, 1000);
  }
  return (
    `${lane} instrumental, ${a.pocketLabel}${keyPart}, ${lowDesc(a.lowShare)}, ` +
    `${brightDesc(a.centroidHz)}, ${densityDesc(a.onsetRate)}, drums and 808s lead the arrangement.`
  ).slice(0, 1000);
}


