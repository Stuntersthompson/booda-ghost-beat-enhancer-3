// Actions for BooDa Beat Enhancer.
//
// The prompt bank is bundled client-side (client/src/bank.json); the server
// only persists Takes — the user's own saved packages and their result
// notes. Every mutation returns the full updated row so the client renders
// server truth directly.
//
// Viewer classification (guest access): every action here is OWNER-ONLY.
// Takes are the owner's private records — there is no collaborative
// surface in this app (the banks are static client content that any
// viewer can browse without actions). A caller counts as the owner
// only when ctx.viewer?.isOwner === true; a missing viewer never
// proves ownership. Reads answer with an explicit owner_required flag
// and no rows; writes refuse with an owner-required error the client
// surfaces, so a guest never sees private rows and never gets an
// unsaved change reported as saved.

import { defineAction, z, type ActionsModule, type Ctx } from "@hatch/space-sdk";
import { count, desc, eq } from "drizzle-orm";
import * as schema from "./schema";

const OWNER_REQUIRED_MESSAGE =
  "These takes belong to the owner — sign in as the owner to view or change them.";

function requireOwner(ctx: Ctx): void {
  if (ctx.viewer?.isOwner !== true) {
    throw new Error(OWNER_REQUIRED_MESSAGE);
  }
}

function isOwner(ctx: Ctx): boolean {
  return ctx.viewer?.isOwner === true;
}

const takeShape = z.object({
  id: z.number(),
  name: z.string(),
  lane: z.string(),
  job_type: z.enum(["original", "preserve"]),
  style: z.string(),
  exclude_text: z.string(),
  lyrics: z.string(),
  settings: z.string(),
  result: z.enum(["pending", "winner", "miss"]),
  next_change: z.string(),
  created_at: z.string(),
});

type TakeRow = typeof schema.takes.$inferSelect;

function toTake(row: TakeRow): z.infer<typeof takeShape> {
  return {
    id: row.id,
    name: row.name,
    lane: row.lane,
    job_type: row.jobType,
    style: row.style,
    exclude_text: row.excludeText,
    lyrics: row.lyrics,
    settings: row.settings,
    result: row.result,
    next_change: row.nextChange,
    created_at: row.createdAt.toISOString(),
  };
}

export const Actions = {
  listTakes: defineAction({
    description:
      "List the owner's saved Takes (built Suno packages with result notes), newest first. Owner-only: signed-out or non-owner viewers get an empty list flagged owner_required.",
    request: z.object({
      limit: z.number().int().positive().max(200).default(100),
    }),
    response: z.object({
      takes: z.array(takeShape),
      total: z.number(),
      owner_required: z.boolean(),
    }),
    async handler(ctx, args) {
      if (!isOwner(ctx)) {
        return { takes: [], total: 0, owner_required: true };
      }
      const db = ctx.db<typeof schema>();
      const rows = await db
        .select()
        .from(schema.takes)
        .orderBy(desc(schema.takes.id))
        .limit(args.limit);
      const totalRows = await db
        .select({ value: count() })
        .from(schema.takes);
      // The total rides along so the client can say honestly when the
      // list is capped ("newest 200 of N") instead of silently hiding
      // older takes.
      return {
        takes: rows.map(toTake),
        total: totalRows[0]?.value ?? rows.length,
        owner_required: false,
      };
    },
  }),

  createTake: defineAction({
    description:
      "Save a new Take — a built Suno package (style, exclude, lyrics map, settings) with its lane and job type. Owner-only.",
    request: z.object({
      name: z.string().min(1).max(120),
      lane: z.string().min(1).max(80),
      job_type: z.enum(["original", "preserve"]),
      style: z.string().max(4000),
      exclude_text: z.string().max(4000),
      lyrics: z.string().max(12000),
      settings: z.string().max(500),
    }),
    response: z.object({ take: takeShape }),
    async handler(ctx, args) {
      requireOwner(ctx);
      const db = ctx.db<typeof schema>();
      const inserted = await db
        .insert(schema.takes)
        .values({
          name: args.name,
          lane: args.lane,
          jobType: args.job_type,
          style: args.style,
          excludeText: args.exclude_text,
          lyrics: args.lyrics,
          settings: args.settings,
        })
        .returning();
      const row = inserted[0];
      if (!row) throw new Error("createTake: insert returned no rows");
      ctx.invalidateQueries();
      return { take: toTake(row) };
    },
  }),

  updateTake: defineAction({
    description:
      "Update a Take's name, result (pending / winner / miss), or next-change note. Owner-only.",
    request: z.object({
      id: z.number().int().positive(),
      name: z.string().min(1).max(120).optional(),
      result: z.enum(["pending", "winner", "miss"]).optional(),
      next_change: z.string().max(1000).optional(),
    }),
    response: z.object({ take: takeShape }),
    async handler(ctx, args) {
      requireOwner(ctx);
      const db = ctx.db<typeof schema>();
      const patch: Partial<{
        name: string;
        result: "pending" | "winner" | "miss";
        nextChange: string;
      }> = {};
      if (args.name !== undefined) patch.name = args.name;
      if (args.result !== undefined) patch.result = args.result;
      if (args.next_change !== undefined) patch.nextChange = args.next_change;
      if (Object.keys(patch).length === 0) {
        // No fields to change: return the current row instead of
        // pushing an empty .set({}) into the update builder.
        const rows = await db
          .select()
          .from(schema.takes)
          .where(eq(schema.takes.id, args.id));
        const current = rows[0];
        if (!current) throw new Error("updateTake: take not found");
        return { take: toTake(current) };
      }
      const updated = await db
        .update(schema.takes)
        .set(patch)
        .where(eq(schema.takes.id, args.id))
        .returning();
      const row = updated[0];
      if (!row) throw new Error("updateTake: take not found");
      ctx.invalidateQueries();
      return { take: toTake(row) };
    },
  }),

  deleteTake: defineAction({
    description: "Delete one of the owner's saved Takes by id. Owner-only.",
    request: z.object({ id: z.number().int().positive() }),
    response: z.object({ ok: z.literal(true) }),
    handler: async (
      ctx,
      args,
    ): Promise<{ ok: true }> => {
      requireOwner(ctx);
      const db = ctx.db<typeof schema>();
      await db.delete(schema.takes).where(eq(schema.takes.id, args.id));
      ctx.invalidateQueries();
      return { ok: true };
    },
  }),
} satisfies ActionsModule;


