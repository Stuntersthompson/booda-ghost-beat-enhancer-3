// The verified BooDa Ghost Suno V2 prompt bank, bundled verbatim from
// suno-v2-prompt-bank-data-2026-10-26.json (owner's file, unedited).
// Counts: Track 1 Original 148 · Track 2 Preservation 126 · Track 3
// Universal 42 · Gospel 75 · Slot templates 14 · Lyrics-box templates 46 ·
// Exclude banks 3 · Settings cards 2.

import rawBank from "./bank.json";

export interface StylePrompt {
  track: number;
  subgenre: string;
  applicability: string;
  text: string;
  chars: number;
}

export interface GospelPrompt {
  track: string;
  subgenre: string;
  group: string;
  applicability: string;
  text: string;
  chars: number;
}

export interface SlotTemplate {
  id: number;
  text: string;
  chars: number;
}

export interface LyricsTemplate {
  topic: string;
  variant: string;
  variant_label: string;
  text: string;
  chars: number;
}

export interface ExcludeBank {
  name: string;
  text: string;
  chars: number;
}

export interface SettingsCard {
  name: string;
  text: string;
}

interface BankShape {
  meta: { name: string; version: string; honesty: string };
  style_prompts: StylePrompt[];
  gospel_prompts: GospelPrompt[];
  slot_templates: SlotTemplate[];
  lyrics_box_templates: LyricsTemplate[];
  exclude_banks: ExcludeBank[];
  settings_cards: SettingsCard[];
}

export const bank = rawBank as BankShape;

export const LOCK_LINE =
  "Preserve the original sample and sampled vocals exactly as performed";

export const STYLE_LIMIT = 1000;
export const EXCLUDE_LIMIT = 1000;
export const LYRICS_LIMIT = 5000;

export type JobType = "original" | "preserve";

/** The 21 subgenre lanes, in the bank's own order. */
export const LANES: string[] = (() => {
  const seen: string[] = [];
  for (const p of bank.style_prompts) {
    if (p.track !== 3 && !seen.includes(p.subgenre)) seen.push(p.subgenre);
  }
  return seen;
})();

/** Track 3 utility lanes (beef-up, texture, groove, low-end, drums, space). */
export const UNIVERSAL_LANES: string[] = (() => {
  const seen: string[] = [];
  for (const p of bank.style_prompts) {
    if (p.track === 3 && !seen.includes(p.subgenre)) seen.push(p.subgenre);
  }
  return seen;
})();

/** The 23 lyrics-box topics, in the bank's own order. */
export const LYRICS_TOPICS: string[] = (() => {
  const seen: string[] = [];
  for (const t of bank.lyrics_box_templates) {
    if (!seen.includes(t.topic)) seen.push(t.topic);
  }
  return seen;
})();

export function stylePromptsFor(job: JobType, lane: string): StylePrompt[] {
  const track = job === "original" ? 1 : 2;
  return bank.style_prompts.filter(
    (p) => p.track === track && p.subgenre === lane,
  );
}

export function universalPrompts(lane: string): StylePrompt[] {
  return bank.style_prompts.filter(
    (p) => p.track === 3 && p.subgenre === lane,
  );
}

export function lyricsTemplateFor(
  topic: string,
  job: JobType,
): LyricsTemplate | undefined {
  const variant = job === "original" ? "A" : "B";
  return bank.lyrics_box_templates.find(
    (t) => t.topic === topic && t.variant === variant,
  );
}

export function gospelPromptsForJobNote(): string {
  return "The gospel set is written for preserve jobs — every prompt carries the sample and sampled-vocals lock.";
}

export function countSummary(): string {
  return `${bank.style_prompts.length} style prompts · ${bank.gospel_prompts.length} gospel · ${bank.slot_templates.length} slot templates · ${bank.lyrics_box_templates.length} lyrics maps`;
}


