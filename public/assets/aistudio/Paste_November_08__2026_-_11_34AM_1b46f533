// Shared UI pieces: copy controls (the heart of the app), character
// counters, steppers, segmented controls.

import { useRef, useState } from "react";

export async function copyText(text: string): Promise<boolean> {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch {
    // Fallback for webviews where the async clipboard API is unavailable.
    try {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(ta);
      return ok;
    } catch {
      return false;
    }
  }
}

export function CopyButton({
  text,
  label = "Copy",
  big = false,
}: {
  text: string;
  label?: string;
  big?: boolean;
}) {
  const [state, setState] = useState<"idle" | "copied" | "failed">("idle");
  const timer = useRef<number | undefined>(undefined);

  async function onCopy() {
    const ok = await copyText(text);
    setState(ok ? "copied" : "failed");
    window.clearTimeout(timer.current);
    timer.current = window.setTimeout(() => setState("idle"), 1800);
  }

  return (
    <button
      type="button"
      onClick={onCopy}
      disabled={text.length === 0}
      aria-label={`${label} (${text.length} characters)`}
      className={`shrink-0 rounded-md font-bold uppercase tracking-wide transition-colors disabled:opacity-40 ${
        big
          ? "min-h-[52px] px-6 text-base"
          : "min-h-[40px] px-4 text-sm"
      } ${
        state === "copied"
          ? "bg-[var(--good)] text-black"
          : state === "failed"
            ? "bg-[var(--danger)] text-white"
            : "bg-[var(--accent)] text-[var(--accent-ink)] active:bg-[#d98d10]"
      }`}
    >
      {state === "copied" ? "Copied" : state === "failed" ? "Failed" : label}
    </button>
  );
}

export function CharCount({
  text,
  limit,
}: {
  text: string;
  limit?: number;
}) {
  const n = text.length;
  const over = limit !== undefined && n > limit;
  return (
    <span
      className={`font-readout whitespace-nowrap text-sm ${over ? "font-bold text-[var(--danger)]" : "text-[var(--dim)]"}`}
      aria-label={
        over
          ? `${n} characters, over the ${limit} limit`
          : `${n} characters${limit ? ` of ${limit}` : ""}`
      }
    >
      {n}
      {limit !== undefined ? ` / ${limit}` : " chars"}
      {over ? " — over" : ""}
    </span>
  );
}

/** A read-only copy-ready block: title, live count, big COPY, exact text. */
export function CopyBlock({
  title,
  text,
  limit,
  mono = false,
}: {
  title: string;
  text: string;
  limit?: number;
  mono?: boolean;
}) {
  return (
    <section className="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)]">
      <div className="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-[var(--border)] px-4 py-2.5">
        <h3 className="font-display text-sm uppercase tracking-wider">{title}</h3>
        <div className="flex flex-wrap items-center gap-2">
          <CharCount text={text} limit={limit} />
          <CopyButton text={text} label={`Copy ${title}`} />
        </div>
      </div>
      <p
        className={`whitespace-pre-wrap break-words px-4 py-3 text-base leading-relaxed ${mono ? "font-readout text-sm" : ""}`}
      >
        {text}
      </p>
    </section>
  );
}

export function Stepper({
  label,
  value,
  min = 0,
  max = 100,
  step = 5,
  onChange,
}: {
  label: string;
  value: number;
  min?: number;
  max?: number;
  step?: number;
  onChange: (v: number) => void;
}) {
  const clamp = (v: number) => Math.min(max, Math.max(min, v));
  return (
    <div className="flex items-center justify-between gap-3 py-1.5">
      <span className="text-base">{label}</span>
      <div className="flex items-center gap-2">
        <button
          type="button"
          aria-label={`${label} decrease`}
          onClick={() => onChange(clamp(value - step))}
          disabled={value <= min}
          className="h-11 w-11 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] text-xl font-bold disabled:opacity-35"
        >
          −
        </button>
        <span className="font-readout w-10 text-center text-lg font-bold">
          {value}
        </span>
        <button
          type="button"
          aria-label={`${label} increase`}
          onClick={() => onChange(clamp(value + step))}
          disabled={value >= max}
          className="h-11 w-11 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] text-xl font-bold disabled:opacity-35"
        >
          +
        </button>
      </div>
    </div>
  );
}

export function SegControl<T extends string>({
  label,
  options,
  value,
  onChange,
}: {
  label: string;
  options: { value: T; label: string }[];
  value: T;
  onChange: (v: T) => void;
}) {
  return (
    <div role="group" aria-label={label} className="flex gap-2">
      {options.map((opt) => {
        const active = opt.value === value;
        return (
          <button
            key={opt.value}
            type="button"
            aria-pressed={active}
            onClick={() => onChange(opt.value)}
            className={`min-h-[48px] flex-1 rounded-md border px-3 text-base font-bold transition-colors ${
              active
                ? "border-[var(--accent)] bg-[var(--accent)] text-[var(--accent-ink)]"
                : "border-[var(--border)] bg-[var(--surface-alt)] text-[var(--text)]"
            }`}
          >
            {opt.label}
          </button>
        );
      })}
    </div>
  );
}

