/** Re-pick library content for a job/lane change, keeping user settings. */
export function repick(prev: BuildState, job: JobType, lane: string): BuildState {
  const style = firstStyle(job, lane);
  const simple = firstSimple(job, lane);
  return {
    ...prev,
    job,
    lane,
    styleText: style.text,
    styleLabel: style.label,
    lyricsTopic: lane,
    lyricsText: buildV6LyricsMap(lane, job),
    lyricsLabel: `v6 detailed structure · ${lane}`,
    simpleText: simple ? simple.text : prev.simpleText,
    simpleLabel: simple
      ? `Simple box · ${simple.title} · ${simple.source}`
      : prev.simpleLabel,
  };
}

export function applySeed(prev: BuildState, seed: BuildSeed): BuildState {
  const next = { ...prev };
  if (seed.job !== undefined) next.job = seed.job;
  if (seed.lane !== undefined) next.lane = seed.lane;
  if (seed.styleText !== undefined) {
    next.styleText = seed.styleText;
    next.styleLabel = seed.styleLabel ?? "Loaded from library";
    // A wholesale-loaded prompt replaces the layered assembly.
    next.moveText = "";
    next.moveLabel = "";
    next.slotDetail = "";
  }
  if (seed.excludeText !== undefined) {
    next.excludeText = seed.excludeText;
    next.excludeCustom = true;
  }
  if (seed.lyricsTopic !== undefined) next.lyricsTopic = seed.lyricsTopic;
  if (seed.lyricsText !== undefined) {
    next.lyricsText = seed.lyricsText;
    next.lyricsLabel = seed.lyricsLabel ?? "Loaded";
  }
  if (seed.simpleText !== undefined) {
    next.simpleText = seed.simpleText;
    next.simpleLabel = seed.simpleLabel ?? "Simple box · loaded";
  }
  return next;
}

/** The compact one-line SETTINGS block, in his recipe's format. */
export function settingsLine(s: BuildState): string {
  const parts = [
    `Model ${s.model}`,
    `Route ${s.job === "preserve" ? "Extend" : "Create"}`,
    `Variety ${s.variety}`,
    `Weirdness ${s.weirdness}`,
    `Style Influence ${s.styleInfluence}`,
  ];
  if (s.job === "preserve") parts.push(`Audio Influence ${s.audioInfluence}`);
  parts.push(`Max Mode ${s.maxMode ? "ON" : "OFF"}`);
  return parts.join(" · ");
}

