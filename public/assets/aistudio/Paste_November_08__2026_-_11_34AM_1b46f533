// Drizzle schema for BooDa Beat Enhancer.
//
// The prompt bank is static, owner-verified reference content bundled into
// the client (client/src/bank.json); it is NOT stored in the database.
// The only persisted user-owned records are Takes — packages the user
// builds and saves, with their result notes.

import { integer, sqliteTable, text } from "drizzle-orm/sqlite-core";

export const takes = sqliteTable("takes", {
  id: integer("id").primaryKey({ autoIncrement: true }),
  name: text("name").notNull(),
  lane: text("lane").notNull(),
  jobType: text("job_type", { enum: ["original", "preserve"] }).notNull(),
  style: text("style").notNull(),
  excludeText: text("exclude_text").notNull(),
  lyrics: text("lyrics").notNull(),
  settings: text("settings").notNull(),
  result: text("result", { enum: ["pending", "winner", "miss"] })
    .notNull()
    .default("pending"),
  nextChange: text("next_change").notNull().default(""),
  createdAt: integer("created_at", { mode: "timestamp_ms" })
    .notNull()
    .$defaultFn(() => new Date()),
});


