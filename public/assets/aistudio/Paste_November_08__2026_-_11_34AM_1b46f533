copyText,
inputCls,
selectCls,
textareaCls,
} from "./ui";

const DRAFT_KEY = "booda-build-draft-v1";

/**
 * The Build draft persists on this device only, so a refresh, an
 * accidental tab close, or the phone browser reclaiming the page
 * never loses a half-built package (measured pain point: Build state
 * previously lived only in component state). Restored once, at first
 * mount; screen-to-screen seeds still land on top of it. Any shape
 * mismatch discards the stored draft rather than trusting it.
 */
function loadDraft(): { state: BuildState; restored: boolean } {
  const fallback = { state: defaultBuildState(), restored: false };
  try {
    const raw = window.localStorage.getItem(DRAFT_KEY);
    if (!raw) return fallback;
    const parsed: unknown = JSON.parse(raw);
    if (typeof parsed !== "object" || parsed === null) return fallback;
    const p = parsed as Partial<BuildState>;
    if (p.job !== "original" && p.job !== "preserve") return fallback;
    if (
      typeof p.lane !== "string" ||
      typeof p.styleText !== "string" ||
      typeof p.lyricsText !== "string" ||
      typeof p.simpleText !== "string" ||
      typeof p.excludeText !== "string"
    ) {
      return fallback;
    }
    // Every remaining field is validated before it is trusted: an
    // earlier shape check let a corrupted or hand-edited draft through
    // with e.g. excludeSel as a number (crashes the Exclude bank
    // buttons — .includes is not a function) or a slider value as a
    // string (the steppers render NaN). Any field that fails its check
    // falls back to the default for that field; the draft's good text
    // still restores.
    const d = defaultBuildState();
    const str = (v: unknown, fb: string) =>
      typeof v === "string" ? v : fb;
    const num = (v: unknown, fb: number) =>
      typeof v === "number" && Number.isFinite(v)
        ? Math.min(100, Math.max(0, Math.round(v)))
        : fb;
    const state: BuildState = {
      job: p.job,
      lane: ALL_LANES.includes(p.lane) ? p.lane : d.lane,
      styleText: p.styleText,
      styleLabel: str(p.styleLabel, d.styleLabel),
      moveText: str(p.moveText, ""),
      moveLabel: str(p.moveLabel, ""),
      slotDetail: str(p.slotDetail, ""),
      excludeSel: Array.isArray(p.excludeSel)
        ? p.excludeSel.filter((n): n is string => typeof n === "string")
        : d.excludeSel,
      excludeText: p.excludeText,
      excludeCustom: p.excludeCustom === true,
      lyricsTopic: str(p.lyricsTopic, d.lyricsTopic),
      lyricsText: p.lyricsText,
      lyricsLabel: str(p.lyricsLabel, d.lyricsLabel),
      simpleText: p.simpleText,
      simpleLabel: str(p.simpleLabel, d.simpleLabel),
      model: ["v6", "v6-mini", "v6-wild"].includes(p.model ?? "")
        ? (p.model as string)
        : d.model,
      variety: num(p.variety, d.variety),
      weirdness: num(p.weirdness, d.weirdness),
      styleInfluence: num(p.styleInfluence, d.styleInfluence),
      audioInfluence: num(p.audioInfluence, d.audioInfluence),
      maxMode: p.maxMode === true,
    };
    return { state, restored: true };
  } catch {
    return fallback;
  }
}

