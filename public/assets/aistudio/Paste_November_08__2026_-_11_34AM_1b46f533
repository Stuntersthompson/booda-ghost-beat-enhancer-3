          <AnalyzeScreen
            analysis={analysis}
            onAnalysis={setAnalysis}
            onSeed={sendToBuild}
          />
        </div>
        <div className={tab === "library" ? undefined : "hidden"}>
          <LibraryScreen onSeed={sendToBuild} />
        </div>
        <div className={tab === "build" ? undefined : "hidden"}>
          <BuildScreen
            seed={seed}
            onOpenTakes={() => setTab("takes")}
            analysis={analysis}
            onClearAnalysis={() => setAnalysis(null)}
