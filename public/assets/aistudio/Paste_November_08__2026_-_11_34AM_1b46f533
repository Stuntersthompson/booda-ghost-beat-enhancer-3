          {open ? "−" : "+"}
        </span>
      </button>
      {open && <div className="space-y-2 px-3 pb-3">{children}</div>}
    </div>
  );
}

function PickRow({
  text,
  meta,
  onPick,
}: {
  text: string;
  meta: string;
  onPick: () => void;
}) {
