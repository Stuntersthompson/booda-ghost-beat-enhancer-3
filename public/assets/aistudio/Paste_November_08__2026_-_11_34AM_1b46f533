// and the full structure in words — ready to paste into that one field
// (with +Audio for a Preserve job). The Simple prompts are also woven
// into the Library and the Build screen; this section is their home,
// not a fence. Character counts here are guidance only — no published
// Simple-box cap exists in our source audit, so none is shown as a
// limit.

import { useMemo, useState } from "react";
import type { BeatAnalysis } from "./analyze";
import { stylePromptsFor, type JobType } from "./bank";
import { ALL_LANES, expansionStylePromptsFor, isExpansionLane } from "./expansion";
import type { BuildSeed } from "./buildState";
import {
frameworkFromAnalysis,
REMIX_FAMILIES,
REMIX_TEMPLATES,
SIMPLE_DIRECTIVES,
SIMPLE_LANES,
SIMPLE_PROMPTS,
SIMPLE_WORKING_LIMIT,
assembleRemixPackage,
assembleSimplePackage,
directiveFor,
randomRemix,
randomSimple,
remixFromAnalysis,
remixTemplatesFor,
simpleFromAnalysis,
type RemixTemplate,
type SimplePrompt,
} from "./simple";
import { CopyBlock, CopyButton, SegControl, inputCls, selectCls } from "./ui";

const PAGE = 30;

function GuidanceCount({ text }: { text: string }) {
  const over = text.length > SIMPLE_WORKING_LIMIT;
  return (
    <span
      className={`font-readout whitespace-nowrap text-sm ${over ? "font-bold text-[var(--danger)]" : "text-[var(--dim)]"}`}
    >
      {text.length} chars · guidance only
      {over ? ` · over the ~${SIMPLE_WORKING_LIMIT.toLocaleString()} working size` : ""}
    </span>
  );
}

export function SimpleScreen({
  analysis,
  onSeed,
