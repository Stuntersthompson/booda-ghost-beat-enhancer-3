// Build-screen state: the package being assembled, its defaults from the
// owner's tested recipe, and the handoff "seed" other screens use to load
// content into the builder.

import {
bank,
lyricsTemplateFor,
stylePromptsFor,
type JobType,
} from "./bank";
import { expansionStylePromptsFor, isExpansionLane } from "./expansion";
import { buildV6LyricsMap } from "./randomize";
import { firstSimple } from "./simple";

export interface BuildState {
  job: JobType;
  lane: string;
  styleText: string;
  styleLabel: string;
  /** Technical-move layer (Ammo bank) folded into the Style output. */
  moveText: string;
  moveLabel: string;
  /** Slot-detail layer folded into the Style output. */
  slotDetail: string;
  excludeSel: string[];
  excludeText: string;
  excludeCustom: boolean;
  lyricsTopic: string;
  lyricsText: string;
  lyricsLabel: string;
  /** Simple-box paragraph (Suno Simple mode's single field), woven into
   * the Build flow alongside the four Advanced blocks. */
  simpleText: string;
  simpleLabel: string;
  model: string;
  variety: number;
  weirdness: number;
  styleInfluence: number;
  audioInfluence: number;
  maxMode: boolean;
}

/** A partial load into the builder, sent by Library / Takes. */
export interface BuildSeed {
  nonce: number;
  job?: JobType;
  lane?: string;
  styleText?: string;
  styleLabel?: string;
  excludeText?: string;
  lyricsTopic?: string;
  lyricsText?: string;
  lyricsLabel?: string;
  simpleText?: string;
  simpleLabel?: string;
}

export function joinExclude(names: string[]): string {
  return bank.exclude_banks
    .filter((b) => names.includes(b.name))
    .map((b) => b.text)
    .join(", ");
}

export function firstStyle(job: JobType, lane: string) {
  if (isExpansionLane(lane)) {
    const picks = expansionStylePromptsFor(job, lane);
    const first = picks[0];
    return {
      text: first ? first.text : "",
      label: first
        ? `Expansion lane · ${lane}`
        : "No library prompt — type your own",
    };
  }
  const picks = stylePromptsFor(job, lane);
  const first = picks[0];
  return {
    text: first ? first.text : "",
    label: first
      ? `Track ${job === "original" ? 1 : 2} · ${lane}`
      : "No library prompt — type your own",
  };
}

export function templateFor(topic: string, job: JobType) {
  const t = lyricsTemplateFor(topic, job);
  return {
    text: t ? t.text : "",
    label: t
      ? `${topic} · ${t.variant_label}`
      : "No template — use a free section map",
  };
}

export function defaultBuildState(): BuildState {
  const lane = "Trap";
  const style = firstStyle("original", lane);
  // Fresh builds open on the v6 detailed structure (Boo's full layout
  // with event-level detail); the bank's own templates stay one tap
  // away in the topic picker, word-for-word.
  const lyrics = {
    text: buildV6LyricsMap(lane, "original"),
    label: `v6 detailed structure · ${lane}`,
  };
  const vocalBank = bank.exclude_banks[0];
  const sel = vocalBank ? [vocalBank.name] : [];
  const simple = firstSimple("original", lane);
  return {
    job: "original",
    lane,
