// TAKES — saved packages with result notes. Stored server-side in the
// artifact's database, so a winning package never gets lost.

import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useEffect, useState } from "react";
import { api, type ApiResponse } from "./api";
import { EXCLUDE_LIMIT, LYRICS_LIMIT, STYLE_LIMIT } from "./bank";
import type { BuildSeed } from "./buildState";
import { CopyBlock, CopyButton, SegControl, inputCls } from "./ui";

type Take = ApiResponse<typeof api, "listTakes">["takes"][number];
type TakeResult = Take["result"];

const RESULT_STYLES: Record<TakeResult, string> = {
  pending: "border-[var(--border)] text-[var(--dim)]",
  winner: "border-[var(--good)] text-[var(--good)]",
  miss: "border-[var(--danger)] text-[var(--danger)]",
};

function TakeCard({
  take,
  onSeed,
}: {
  take: Take;
  onSeed: (seed: Omit<BuildSeed, "nonce">) => void;
}) {
  const [open, setOpen] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);
  const [name, setName] = useState(take.name);
  const [nextChange, setNextChange] = useState(take.next_change);
  const queryClient = useQueryClient();

  // Keep the editable fields on server truth: they were previously
  // seeded once from the row and never re-synced, so after a refetch
  // carrying a newer name/note (e.g. saved from another device) the
  // card kept showing — and could re-save — the stale text, and its
  // Save button's disabled check compared against the wrong baseline.
  useEffect(() => {
    setName(take.name);
  }, [take.name]);
  useEffect(() => {
    setNextChange(take.next_change);
  }, [take.next_change]);

  const refresh = () =>
    queryClient.invalidateQueries({ queryKey: ["takes"] });

  const update = useMutation({
    mutationFn: (args: {
      id: number;
      name?: string;
      result?: TakeResult;
      next_change?: string;
    }) => api.updateTake(args),
    onSuccess: refresh,
  });

  const remove = useMutation({
    mutationFn: (id: number) => api.deleteTake({ id }),
    onSuccess: refresh,
  });

  // Duplicate: re-save this package as a fresh pending Take so a
  // winner can be iterated (change one variable, keep the original
  // untouched) without rebuilding it in Build first.
  const duplicate = useMutation({
    mutationFn: () =>
      api.createTake({
        name: `${take.name} (copy)`.slice(0, 120),
        lane: take.lane,
        job_type: take.job_type,
        style: take.style,
        exclude_text: take.exclude_text,
        lyrics: take.lyrics,
        settings: take.settings,
      }),
    onSuccess: refresh,
  });

  const fullPackageText = [
    `STYLE\n${take.style}`,
    `EXCLUDE\n${take.exclude_text}`,
    `LYRICS MAP\n${take.lyrics}`,
    `SETTINGS\n${take.settings}`,
  ].join("\n\n");

  function downloadPackage() {
    const blob = new Blob([fullPackageText], {
      type: "text/plain;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const aEl = document.createElement("a");
    aEl.href = url;
    aEl.download = `${take.name.replace(/[^\w\- ]+/g, "").trim().replace(/\s+/g, "-") || `take-${take.id}`}.txt`;
    document.body.appendChild(aEl);
    aEl.click();
    document.body.removeChild(aEl);
    URL.revokeObjectURL(url);
  }

  const when = new Date(take.created_at).toLocaleString(undefined, {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });

  return (
    <li className="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] px-4 py-3">
      <div className="flex items-start justify-between gap-3">
        <div>
          <h3 className="font-display text-lg leading-tight">{take.name}</h3>
          <p className="mt-1 text-sm text-[var(--dim)]">
            {take.lane} · {take.job_type === "preserve" ? "Preserve" : "Original"} ·{" "}
            {when}
          </p>
        </div>
        <span
          className={`shrink-0 rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-wide ${RESULT_STYLES[take.result]}`}
        >
          {take.result}
        </span>
      </div>

      <div className="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          aria-expanded={open}
          onClick={() => setOpen((o) => !o)}
          className="min-h-[44px] rounded-md bg-[var(--accent)] px-4 font-bold text-[var(--accent-ink)]"
        >
          {open ? "Close" : "Open package"}
        </button>
        <button
          type="button"
          onClick={() =>
            onSeed({
              job: take.job_type,
              lane: take.lane,
              styleText: take.style,
              styleLabel: `From take “${take.name}”`,
              excludeText: take.exclude_text,
              lyricsText: take.lyrics,
              lyricsLabel: `From take “${take.name}”`,
            })
          }
          className="min-h-[44px] rounded-md border border-[var(--accent)] px-4 font-bold text-[var(--accent)]"
        >
          Load into Build
        </button>
      </div>

      {open && (
        <div className="mt-4 space-y-3">
          <CopyBlock title="Style" text={take.style} limit={STYLE_LIMIT} />
          <CopyBlock title="Exclude" text={take.exclude_text} limit={EXCLUDE_LIMIT} />
          <CopyBlock title="Lyrics map" text={take.lyrics} limit={LYRICS_LIMIT} />
          <CopyBlock title="Settings" text={take.settings} mono />
          <div className="[&>button]:w-full">
            <CopyButton big label="Copy full package" text={fullPackageText} />
          </div>
          <div className="flex flex-wrap gap-2">
            <button
              type="button"
              onClick={downloadPackage}
              className="min-h-[48px] flex-1 rounded-md border border-[var(--accent)] px-4 font-bold text-[var(--accent)]"
            >
              Download .txt
            </button>
            <button
              type="button"
              onClick={() => duplicate.mutate()}
              disabled={duplicate.isPending}
              className="min-h-[48px] flex-1 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 font-bold disabled:opacity-40"
            >
              {duplicate.isPending ? "Duplicating…" : "Duplicate take"}
            </button>
          </div>
          {duplicate.isSuccess && (
            <p className="text-sm font-bold text-[var(--good)]">
              Duplicated — the copy is at the top of the list as “{take.name}{" "}
              (copy)”, pending.
            </p>
          )}
          {duplicate.isError && (
            <p className="text-sm font-bold text-[var(--danger)]">
              {duplicate.error instanceof Error &&
              duplicate.error.message.includes("owner")
                ? "These takes belong to the owner — sign in as the owner to duplicate takes."
                : "Duplicate failed — try again."}
            </p>
          )}

          <div>
            <p className="font-display text-sm uppercase tracking-wider">
              Result
            </p>
            <div className="mt-1.5">
              <SegControl<TakeResult>
                label="Take result"
                value={take.result}
                onChange={(v) => update.mutate({ id: take.id, result: v })}
                options={[
                  { value: "pending", label: "Pending" },
                  { value: "winner", label: "Winner" },
                  { value: "miss", label: "Miss" },
                ]}
              />
            </div>
          </div>

          <div>
            <label htmlFor={`take-name-${take.id}`} className="font-display text-sm uppercase tracking-wider">
              Name
            </label>
            <div className="mt-1.5 flex gap-2">
              <input
                id={`take-name-${take.id}`}
                value={name}
                onChange={(e) => setName(e.target.value)}
                maxLength={120}
                className={inputCls}
              />
              <button
                type="button"
                disabled={name.trim() === "" || name === take.name || update.isPending}
                onClick={() => update.mutate({ id: take.id, name: name.trim() })}
                className="min-h-[48px] shrink-0 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 font-bold disabled:opacity-40"
              >
                Save
              </button>
            </div>
          </div>

          <div>
            <label htmlFor={`take-next-${take.id}`} className="font-display text-sm uppercase tracking-wider">
              What to change next take
            </label>
            <div className="mt-1.5 flex gap-2">
              <input
                id={`take-next-${take.id}`}
                value={nextChange}
                onChange={(e) => setNextChange(e.target.value)}
                placeholder="One change only — e.g. sparser 808"
                maxLength={1000}
                className={inputCls}
              />
              <button
                type="button"
                disabled={nextChange === take.next_change || update.isPending}
                onClick={() =>
                  update.mutate({ id: take.id, next_change: nextChange })
                }
                className="min-h-[48px] shrink-0 rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 font-bold disabled:opacity-40"
              >
                Save
              </button>
            </div>
          </div>

          {update.isError && (
            <p className="text-sm font-bold text-[var(--danger)]">
              That change didn't save — try again.
            </p>
          )}

          <div className="border-t border-[var(--border)] pt-3">
            {confirmDelete ? (
              <div className="flex flex-wrap items-center gap-2">
                <span className="text-base font-bold">Delete this take?</span>
                <button
                  type="button"
                  onClick={() => remove.mutate(take.id)}
                  disabled={remove.isPending}
                  className="min-h-[44px] rounded-md bg-[var(--danger)] px-4 font-bold text-white disabled:opacity-40"
                >
                  {remove.isPending ? "Deleting…" : "Yes, delete"}
                </button>
                <button
                  type="button"
                  onClick={() => setConfirmDelete(false)}
                  className="min-h-[44px] rounded-md border border-[var(--border)] bg-[var(--surface-alt)] px-4 font-bold"
                >
                  Keep it
                </button>
              </div>
            ) : (
              <button
                type="button"
                onClick={() => setConfirmDelete(true)}
                className="min-h-[44px] rounded-md border border-[var(--danger)] px-4 font-bold text-[var(--danger)]"
              >
                Delete take
              </button>
            )}
            {remove.isError && (
              <p className="mt-2 text-sm font-bold text-[var(--danger)]">
                Delete failed — try again.
              </p>
            )}
          </div>
        </div>
      )}
