<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full 108dp adaptive icon viewport so <adaptive-icon> never scales up the inner safe-zone item -->
    <item
        android:width="108dp"
        android:height="108dp">
        <shape android:shape="rectangle">
            <size
                android:width="108dp"
                android:height="108dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- 49dp x 40dp preserves 302:246 ratio with diagonal 63.25dp strictly inside the 66dp safe zone -->
    <item
        android:width="49dp"
        android:height="40dp"
        android:drawable="@drawable/booda_official_logo"
        android:gravity="center" />
</layer-list>
